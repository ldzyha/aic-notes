{
  "name": "aic-notes",
  "displayName": "AIC Notes",
  "description": "Local AIC Markdown documents and one workspace note with a page per file, with no account connection or note synchronization.",
  "version": "60.0.2",
  "aicEditorCore": "7.5.3",
  "publisher": "ldzyha",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldzyha/aic-notes.git"
  },
  "bugs": {
    "url": "https://github.com/ldzyha/aic-notes/issues"
  },
  "homepage": "https://github.com/ldzyha/aic-notes#readme",
  "keywords": [
    "markdown",
    "notes",
    "workspace notes",
    "mermaid",
    "wysiwyg",
    "editor"
  ],
  "galleryBanner": {
    "color": "#121212",
    "theme": "dark"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Local Markdown editing with Save, Ctrl+S/Cmd+S, focus-leave saving and acknowledged security actions."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Markdown notes use the workspace filesystem provider and VS Code Save/Undo. Editing and linked-note writes require a writable provider; read-only documents remain readable."
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node scripts/test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "install:vsix": "npm run package && node scripts/package.mjs --install",
    "release:checksum": "node scripts/checksum.mjs",
    "core:check": "node scripts/verify-core.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:gate": "npm run core:check && npm test && npm run package && npm run release:checksum && npm run release:verify"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aicNotesSecondary",
          "title": "AIC Note",
          "icon": "media/notes.svg"
        }
      ]
    },
    "views": {
      "aicNotesSecondary": [
        {
          "id": "aicNotes.secondary",
          "name": "Linked Note",
          "type": "webview",
          "icon": "media/notes.svg",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "aicNotes.noteForCurrentFile",
        "title": "Open Note Page for Current File",
        "category": "AIC Notes",
        "icon": "$(note)"
      },
      {
        "command": "aicNotes.useNativeForMarkdown",
        "title": "Use Native Editor for Plain Markdown",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.enableAgentWorkflow",
        "title": "Enable AIC Agent Workflow",
        "category": "AIC Notes",
        "icon": "$(sparkle)"
      },
      {
        "command": "aicNotes.syncAgentInstructions",
        "title": "Sync Agent Instructions",
        "category": "AIC Notes",
        "icon": "$(sync)"
      },
      {
        "command": "aicNotes.copyAgentInstructions",
        "title": "Copy Agent Instructions",
        "category": "AIC Notes"
      }
    ],
    "keybindings": [
      {
        "command": "aicNotes.noteForCurrentFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aicNotes.noteForCurrentFile",
          "when": "isFileSystemResource",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "aicNotes.noteRedirect",
        "displayName": "AIC Markdown (Legacy Note Association)",
        "selector": [
          {
            "filenamePattern": "*.note.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "aicNotes.markdown",
        "displayName": "AIC Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.note.md": "aicNotes.markdown",
        "*.md": "aicNotes.markdown"
      }
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "6.0.2",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/javascript": "1.5.4",
    "@lezer/markdown": "^1.6.4",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.3.0",
    "adm-zip": "0.5.16",
    "esbuild": "^0.28.0",
    "mermaid": "11.16.1",
    "xml2js": "0.6.2",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "jsqr": "1.4.0"
  },
  "browser": "./dist/extension-browser.cjs"
}

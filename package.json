{
  "name": "aic-notes",
  "displayName": "AIC Notes",
  "description": "Local AIC Markdown documents and linked notes, with no account connection or note synchronization.",
  "version": "52.1.0",
  "aicEditorCore": "7.3.0",
  "publisher": "ldzyha",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldzyha/aic-notes.git"
  },
  "bugs": {
    "url": "https://github.com/ldzyha/aic-notes/issues"
  },
  "homepage": "https://github.com/ldzyha/aic-notes#readme",
  "keywords": [
    "markdown",
    "notes",
    "sidecar notes",
    "mermaid",
    "wysiwyg",
    "editor"
  ],
  "galleryBanner": {
    "color": "#121212",
    "theme": "dark"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Local Markdown editing with Save, Ctrl+S/Cmd+S, focus-leave saving and acknowledged security actions."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The editor and linked-note pane use workspace.fs; wiki-link resolution needs stat support on the virtual filesystem."
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node scripts/test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "install:vsix": "npm run package && node scripts/package.mjs --install",
    "release:checksum": "node scripts/checksum.mjs",
    "core:check": "node scripts/verify-core.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:gate": "npm run core:check && npm test && npm run package && npm run release:checksum && npm run release:verify"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aicNotesSecondary",
          "title": "AIC Note",
          "icon": "media/notes.svg"
        }
      ]
    },
    "views": {
      "aicNotesSecondary": [
        {
          "id": "aicNotes.secondary",
          "name": "Linked Note",
          "type": "webview",
          "icon": "media/notes.svg",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "aicNotes.noteForCurrentFile",
        "title": "Open Linked Note",
        "category": "AIC Notes",
        "icon": "$(note)"
      },
      {
        "command": "aicNotes.linkSelectionToNote",
        "title": "Link Selection to Note",
        "category": "AIC Notes",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aicNotes.openInSecondary",
        "title": "Open Note in Secondary Side Bar",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.noteForExplorerItem",
        "title": "Open Linked Note",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.openProjectNote",
        "title": "Open Project Note",
        "category": "AIC Notes",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "aicNotes.enableExplorerNesting",
        "title": "Enable Explorer Nesting for Notes",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.openSource",
        "title": "Open Source",
        "category": "AIC Notes",
        "icon": "$(go-to-file)"
      },
      {
        "command": "aicNotes.useNativeForMarkdown",
        "title": "Use Native Editor for Plain Markdown",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.enableAgentWorkflow",
        "title": "Enable AIC Agent Workflow",
        "category": "AIC Notes",
        "icon": "$(sparkle)"
      },
      {
        "command": "aicNotes.syncAgentInstructions",
        "title": "Sync Agent Instructions",
        "category": "AIC Notes",
        "icon": "$(sync)"
      }
    ],
    "keybindings": [
      {
        "command": "aicNotes.noteForCurrentFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "aicNotes.linkSelectionToNote",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file && resourceFilename not =~ /\\.note\\.md$/"
      },
      {
        "command": "aicNotes.linkSelectionToNote",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file && resourceFilename not =~ /\\.note\\.md$/"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aicNotes.openSource",
          "when": "resourceScheme == file && resourceFilename =~ /\\.note\\.md$/",
          "group": "navigation"
        },
        {
          "command": "aicNotes.noteForCurrentFile",
          "when": "resourceScheme == file && resourceFilename not =~ /\\.note\\.md$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "aicNotes.openSource",
          "when": "resourceScheme == file && resourceFilename =~ /\\.note\\.md$/",
          "group": "navigation@1"
        },
        {
          "command": "aicNotes.noteForExplorerItem",
          "group": "2_workspace"
        }
      ],
      "editor/context": [
        {
          "command": "aicNotes.linkSelectionToNote",
          "when": "editorHasSelection && resourceScheme == file && resourceFilename not =~ /\\.note\\.md$/",
          "group": "navigation@10"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "aicNotes.noteRedirect",
        "displayName": "AIC Markdown (Legacy Note Association)",
        "selector": [
          {
            "filenamePattern": "*.note.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "aicNotes.markdown",
        "displayName": "AIC Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.note.md": "aicNotes.markdown",
        "*.md": "aicNotes.markdown"
      },
      "explorer.fileNesting.patterns": {
        "*.js": "${capture}.note.md",
        "*.mjs": "${capture}.note.md",
        "*.cjs": "${capture}.note.md",
        "*.ts": "${capture}.note.md",
        "*.jsx": "${capture}.note.md",
        "*.tsx": "${capture}.note.md",
        "*.py": "${capture}.note.md",
        "*.rs": "${capture}.note.md",
        "*.go": "${capture}.note.md",
        "*.java": "${capture}.note.md",
        "*.rb": "${capture}.note.md",
        "*.php": "${capture}.note.md",
        "*.css": "${capture}.note.md",
        "*.scss": "${capture}.note.md",
        "*.html": "${capture}.note.md",
        "*.isml": "${capture}.note.md",
        "*.json": "${capture}.note.md",
        "*.jsonc": "${capture}.note.md",
        "*.toml": "${capture}.note.md",
        "*.yml": "${capture}.note.md",
        "*.yaml": "${capture}.note.md",
        "*.md": "${capture}.note.md",
        "*.sh": "${capture}.note.md",
        "*.sql": "${capture}.note.md",
        "*.xml": "${capture}.note.md",
        "*.svg": "${capture}.note.md",
        "*.txt": "${capture}.note.md",
        "*.vue": "${capture}.note.md",
        "*.svelte": "${capture}.note.md",
        ".env": ".env.note.md",
        ".gitignore": ".gitignore.note.md",
        "Makefile": "Makefile.note.md",
        "Dockerfile": "Dockerfile.note.md"
      }
    },
    "configuration": {
      "title": "AIC Notes",
      "properties": {
        "aicNotes.agentWorkflow.aicPath": {
          "type": "string",
          "default": "aic",
          "scope": "machine",
          "description": "AIC executable used only for typed agent-rule status and sync commands. Use an absolute path when AIC is not on code-server's PATH."
        }
      }
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "6.0.2",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/javascript": "1.5.4",
    "@lezer/markdown": "^1.6.4",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.3.0",
    "adm-zip": "0.5.16",
    "esbuild": "^0.28.0",
    "mermaid": "11.16.1",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "jsqr": "1.4.0"
  }
}

{
  "name": "aic-notes",
  "displayName": "AIC Notes",
  "description": "AIC Markdown documents plus Secondary-Side-Bar-only *.note.md notes with explicit-save Standard Notes sync.",
  "version": "12.0.1",
  "aicEditorCore": "2.1.0",
  "publisher": "ldzyha",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldzyha/aic-notes.git"
  },
  "bugs": {
    "url": "https://github.com/ldzyha/aic-notes/issues"
  },
  "homepage": "https://github.com/ldzyha/aic-notes#readme",
  "keywords": [
    "markdown",
    "notes",
    "sidecar notes",
    "mermaid",
    "wysiwyg",
    "editor"
  ],
  "galleryBanner": {
    "color": "#121212",
    "theme": "dark"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Local rendering and editing are supported; connected Markdown documents and *.note.md notes synchronize after explicit Ctrl+S/Cmd+S save."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Notes tree and editor use workspace.fs; wiki-link resolution needs stat support on the virtual filesystem."
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "package": "npm run build && vsce package --no-dependencies --target linux-x64 --out aic-notes-$npm_package_version-linux-x64.vsix",
    "package:windows": "npm run build && vsce package --no-dependencies --target win32-x64 --out aic-notes-$npm_package_version-win32-x64.vsix",
    "install:vsix": "npm run package && code-server --install-extension aic-notes-$npm_package_version-linux-x64.vsix --force",
    "release:verify": "node scripts/verify-release.mjs",
    "release:gate": "npm test && npm run package && npm run package:windows && npm run release:verify"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aicNotes",
          "title": "Notes",
          "icon": "media/notes.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "aicNotesSecondary",
          "title": "AIC Note",
          "icon": "media/notes.svg"
        }
      ]
    },
    "views": {
      "aicNotes": [
        {
          "id": "aicNotes.tree",
          "name": "Notes & Documents",
          "icon": "media/notes.svg"
        }
      ],
      "aicNotesSecondary": [
        {
          "id": "aicNotes.secondary",
          "name": "Linked Note",
          "type": "webview",
          "icon": "media/notes.svg",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "aicNotes.noteForCurrentFile",
        "title": "Open Linked Note",
        "category": "AIC Notes",
        "icon": "$(note)"
      },
      {
        "command": "aicNotes.linkSelectionToNote",
        "title": "Link Selection to Note",
        "category": "AIC Notes",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aicNotes.syncCurrentNote",
        "title": "Sync Current Note",
        "category": "AIC Notes",
        "icon": "$(sync)"
      },
      {
        "command": "aicNotes.pullProjectNotes",
        "title": "Pull Project Notes from Standard Notes",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.openInSecondary",
        "title": "Open Note in Secondary Side Bar",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.noteForExplorerItem",
        "title": "Open Linked Note",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.openProjectNote",
        "title": "Open Project Note",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.refreshTree",
        "title": "Refresh",
        "category": "AIC Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "aicNotes.enableExplorerNesting",
        "title": "Enable Explorer Nesting for Notes",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.openTarget",
        "title": "Open Target",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.copyWikiLink",
        "title": "Copy Wiki Link",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.useNativeForMarkdown",
        "title": "Use Native Editor for Plain Markdown",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.deleteNote",
        "title": "Delete Note",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.deleteFolderNotes",
        "title": "Delete All Notes in Folder",
        "category": "AIC Notes"
      },
      {
        "command": "aicNotes.enableAgentWorkflow",
        "title": "Enable AIC Agent Workflow",
        "category": "AIC Notes",
        "icon": "$(sparkle)"
      },
      {
        "command": "aicNotes.syncAgentInstructions",
        "title": "Sync Agent Instructions",
        "category": "AIC Notes",
        "icon": "$(sync)"
      }
    ],
    "keybindings": [
      {
        "command": "aicNotes.noteForCurrentFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "aicNotes.linkSelectionToNote",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file && resourceFilename not =~ /\\.note\\.md$/"
      },
      {
        "command": "aicNotes.linkSelectionToNote",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file && resourceFilename not =~ /\\.note\\.md$/"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aicNotes.noteForCurrentFile",
          "when": "resourceScheme == file && resourceFilename not =~ /\\.note\\.md$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "aicNotes.noteForExplorerItem",
          "group": "2_workspace"
        }
      ],
      "editor/context": [
        {
          "command": "aicNotes.linkSelectionToNote",
          "when": "editorHasSelection && resourceScheme == file && resourceFilename not =~ /\\.note\\.md$/",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "aicNotes.noteForCurrentFile",
          "when": "view == aicNotes.tree",
          "group": "navigation@1"
        },
        {
          "command": "aicNotes.refreshTree",
          "when": "view == aicNotes.tree",
          "group": "navigation@2"
        },
        {
          "command": "aicNotes.enableAgentWorkflow",
          "when": "view == aicNotes.tree && workspaceFolderCount > 0",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "aicNotes.openTarget",
          "when": "view == aicNotes.tree && viewItem == note",
          "group": "navigation@1"
        },
        {
          "command": "aicNotes.copyWikiLink",
          "when": "view == aicNotes.tree && viewItem =~ /note/",
          "group": "1_copy@1"
        },
        {
          "command": "aicNotes.deleteNote",
          "when": "view == aicNotes.tree && viewItem == note",
          "group": "9_delete@1"
        },
        {
          "command": "aicNotes.deleteFolderNotes",
          "when": "view == aicNotes.tree && viewItem =~ /^(dir|bucket)$/",
          "group": "9_delete@1"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "aicNotes.noteRedirect",
        "displayName": "AIC Note (Secondary Side Bar)",
        "selector": [
          {
            "filenamePattern": "*.note.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "aicNotes.markdown",
        "displayName": "AIC Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.note.md": "aicNotes.noteRedirect",
        "*.md": "aicNotes.markdown"
      },
      "explorer.fileNesting.patterns": {
        "*.js": "${capture}.note.md",
        "*.mjs": "${capture}.note.md",
        "*.cjs": "${capture}.note.md",
        "*.ts": "${capture}.note.md",
        "*.jsx": "${capture}.note.md",
        "*.tsx": "${capture}.note.md",
        "*.py": "${capture}.note.md",
        "*.rs": "${capture}.note.md",
        "*.go": "${capture}.note.md",
        "*.java": "${capture}.note.md",
        "*.rb": "${capture}.note.md",
        "*.php": "${capture}.note.md",
        "*.css": "${capture}.note.md",
        "*.scss": "${capture}.note.md",
        "*.html": "${capture}.note.md",
        "*.isml": "${capture}.note.md",
        "*.json": "${capture}.note.md",
        "*.jsonc": "${capture}.note.md",
        "*.toml": "${capture}.note.md",
        "*.yml": "${capture}.note.md",
        "*.yaml": "${capture}.note.md",
        "*.md": "${capture}.note.md",
        "*.sh": "${capture}.note.md",
        "*.sql": "${capture}.note.md",
        "*.xml": "${capture}.note.md",
        "*.svg": "${capture}.note.md",
        "*.txt": "${capture}.note.md",
        "*.vue": "${capture}.note.md",
        "*.svelte": "${capture}.note.md",
        ".env": ".env.note.md",
        ".gitignore": ".gitignore.note.md",
        "Makefile": "Makefile.note.md",
        "Dockerfile": "Dockerfile.note.md"
      }
    },
    "configuration": {
      "title": "AIC Notes",
      "properties": {
        "aicNotes.standardNotes.server": {
          "type": "string",
          "default": "https://api.standardnotes.com",
          "description": "Standard Notes API server used only by explicit Connect/Sync actions."
        },
        "aicNotes.standardNotes.bridgePath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a compatible native helper on Linux. Windows uses the bundled in-process WebAssembly bridge."
        },
        "aicNotes.agentWorkflow.aicPath": {
          "type": "string",
          "default": "aic",
          "scope": "machine",
          "description": "AIC executable used only for typed agent-rule status and sync commands. Use an absolute path when AIC is not on code-server's PATH."
        }
      }
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "6.0.2",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.3.0",
    "adm-zip": "0.5.16",
    "esbuild": "^0.28.0",
    "mermaid": "11.16.1"
  }
}
